# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly mark these as binary (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pth filter=lfs diff=lfs merge=lfs -text
*.wav binary
*.mp3 binary
*.flac binary
